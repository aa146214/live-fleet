# FleetSmart API key from Admin > Manage API Keys (server-side only, never sent to the browser).
# Leave blank to run the app with the illustrative demo vehicles.
FLEETSMART_API_KEY=

# Optional: customer ID, sent as X-CLIENT-ID when set. The API currently accepts the key alone.
FLEETSMART_CLIENT_ID=

# Optional: override the API base URL.
# FLEETSMART_BASE_URL=https://www.fleetsmartlive.com/api

# Optional: Valhalla router used to move minibuses along roads (defaults to the public FOSSGIS
# server, which is for light, non-commercial use).
# VALHALLA_URL=https://valhalla1.openstreetmap.de
